{
  "name": "leadmapper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && cross-env ENTRY=background vite build && cross-env ENTRY=content vite build && cross-env ENTRY=popup vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "biome lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
